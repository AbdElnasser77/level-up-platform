# Normalize line endings to LF in the repository and on checkout.
# Keeps Windows, macOS and Linux checkouts byte-identical so Prettier
# (which defaults to endOfLine: "lf") stays consistent everywhere.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
